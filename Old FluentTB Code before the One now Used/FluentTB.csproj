<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FluentTB</AssemblyName>
    <RootNamespace>FluentTB</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>res\FluentTB.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Optimize>false</Optimize>
    <WarningLevel>4</WarningLevel>
    <LangVersion>latest</LangVersion>
    <!-- Version 2026.3.0.0 — Q3 2026 release -->
    <Version>2026.3.0.0</Version>
    <AssemblyVersion>2026.3.0.0</AssemblyVersion>
    <FileVersion>2026.3.0.0</FileVersion>
    <InformationalVersion>2026.3.0.0</InformationalVersion>
    <Product>FluentTB</Product>
    <Company>FluentTB</Company>
    <Copyright>Copyright © 2026 FluentTB Contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- System tray icon (WPF) -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
    <!-- Modern WPF theming (.NET 8 compatible fork of ModernWpf) -->
    <!-- <PackageReference Include="ModernWpfUI" Version="0.9.4" /> -->
    <!-- JSON settings persistence -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- dynamic keyword support for late-binding COM (WScript.Shell startup shortcut) -->
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="res\FluentTB.ico" />
    <Resource Include="res\FluentTB.png" />
    <Resource Include="res\TrayDark.ico" />
    <Resource Include="res\TrayLight.ico" />
    <Resource Include="res\Headbanner.png" />
    <Resource Include="res\HeadBannerDev.png" />
  </ItemGroup>

</Project>
