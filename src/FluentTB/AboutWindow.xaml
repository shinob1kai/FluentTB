<Window x:Class="FluentTB.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FluentTB"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        Title="FluentTB - About"
        Height="616" Width="500"
        ui:WindowHelper.UseModernWindowStyle="True"
        ResizeMode="NoResize"
        Opacity="1.001">
    <Grid>
        <!-- Release version header -->
        <Image x:Name="bannerMst"
               Visibility="Visible"
               HorizontalAlignment="Center"
               Height="128" Width="500"
               VerticalAlignment="Top"
               Opacity="0.8"
               Source="res\Headbanner.png"
               Stretch="UniformToFill"
               Margin="0,-37,0,0"/>
        <Image x:Name="bannerDev"
               Visibility="Hidden"
               HorizontalAlignment="Center"
               Height="128" Width="500"
               VerticalAlignment="Top"
               Opacity="0.8"
               Source="res\HeadBannerDev.png"
               Stretch="UniformToFill"
               Margin="0,-37,0,0"/>
        <Image x:Name="bannerCan"
               Visibility="Hidden"
               HorizontalAlignment="Center"
               Height="128" Width="500"
               VerticalAlignment="Top"
               Opacity="0.8"
               Source="res\HeadBannerCan.png"
               Stretch="UniformToFill"
               Margin="0,-37,0,0"/>

        <!-- Title & subtitle -->
        <TextBlock x:Name="titleBlock"
                   HorizontalAlignment="Left"
                    Margin="10,2,0,0"
                   TextWrapping="Wrap"
                    Text="Welcome to FluentTB!"
                   VerticalAlignment="Top"
                   FontFamily="Segoe UI Semibold"
                   FontWeight="Normal"
                   FontSize="36"
                   Opacity="0.795"/>
        <TextBlock x:Name="subtitleBlock"
                   HorizontalAlignment="Left"
                    Margin="10,50,0,0"
                   TextWrapping="Wrap"
                    Text="Release 2026.3 (v2026.3.1.0)"
                   VerticalAlignment="Top"
                   FontFamily="Segoe UI Semibold"
                   FontWeight="Normal"
                   FontSize="22"
                   Opacity="0.795"
                   Height="30"/>

        <TextBlock x:Name="bodyBlockMain"
                    Margin="10,97,10,0"
                   VerticalAlignment="Top"
                   TextWrapping="Wrap"
                   FontFamily="Segoe UI SemiBold"
                   FontWeight="Normal"
                    FontSize="14"
                    Height="37">
            <Bold>Thanks for using FluentTB. Expand the following categories for more information.</Bold>
        </TextBlock>

        <!-- Scrollable expander area -->
        <ScrollViewer Margin="0,136,0,62">
            <StackPanel>

                <!-- What's new -->
                <Expander x:Name="expander0"
                          HorizontalAlignment="Center"
                          Header="What's new in FluentTB"
                          Width="480" FontSize="16"
                          FontFamily="Segoe UI Semibold">
                    <Grid>
                        <TextBlock x:Name="bodyBlock0"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   FontFamily="Segoe UI"
                                   FontWeight="Normal"
                                   FontSize="14"
                                   Opacity="0.8"
                                   LineHeight="23">
                            • Automatic background update checks (every 24 hours)
                            <LineBreak/>
                            • Windows notifications for available updates
                            <LineBreak/>
                            • One-click update installation via notification
                            <LineBreak/>
                            • Shell-hook based maximise detection — instant, no polling delay
                            <LineBreak/>
                            • Reliable TranslucentTB compatibility (mutex-based detection)
                            <LineBreak/>
                            • Background worker restart no longer causes UI freezes
                            <LineBreak/>
                            • Modern Fluent Design with improved icon set
                            <LineBreak/>
                            <Bold>NOTE: Dynamic mode and Autohide are temporarily disabled in this version.</Bold>
                        </TextBlock>
                    </Grid>
                </Expander>

                <!-- Basic options -->
                <Expander x:Name="expander1"
                          HorizontalAlignment="Center"
                          Header="Basic options"
                          Width="480" FontSize="16"
                          FontFamily="Segoe UI Semibold">
                    <Grid>
                        <TextBlock x:Name="bodyBlock1"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   FontFamily="Segoe UI"
                                   FontWeight="Normal"
                                   FontSize="14"
                                   Opacity="0.8"
                                   LineHeight="23">
                            <Bold>• Margin</Bold> — shrinks the taskbar on all sides by this many logical pixels.
                            <LineBreak/>
                            <Bold>• Corner radius</Bold> — controls how round the corners are.
                            <LineBreak/>
                            <Bold>• Advanced</Bold> — opens the advanced settings panel.
                            <LineBreak/>
                            <Bold>• Apply</Bold> — saves and applies any pending changes.
                        </TextBlock>
                    </Grid>
                </Expander>

                <!-- Advanced options -->
                <Expander x:Name="expander2"
                          HorizontalAlignment="Center"
                          Header="Advanced options"
                          Width="480" FontSize="16"
                          FontFamily="Segoe UI Semibold">
                    <Grid>
                        <TextBlock x:Name="bodyBlock2"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   FontFamily="Segoe UI"
                                   FontWeight="Normal"
                                   FontSize="14"
                                   Opacity="0.8"
                                   LineHeight="23">
                            <Bold>• [...] Margins</Bold> — sets each side's margin independently. Negative values attach the taskbar to a screen edge.
                            <LineBreak/>
                            <Bold>• Show system tray</Bold> — show/hide the clock &amp; tray. Toggle anytime with <Bold>Win+F2</Bold>.
                            <LineBreak/>
                            <Bold>• Show tray on hover</Bold> — shows the tray only when the mouse is over it.
                            <LineBreak/>
                            <Bold>• TranslucentTB compatibility</Bold> — enables co-operation with TranslucentTB 2021.5+.
                            <LineBreak/>
                            <Bold>• Fill when maximised</Bold> — resets the taskbar region when a window is maximised.
                            <LineBreak/>
                            <Bold>• Fill on alt+tab</Bold> — also fills when the Task Switcher is open.
                            <LineBreak/>
                            <Bold>NOTE:</Bold> Dynamic mode and shadow effect are temporarily disabled in this release.
                        </TextBlock>
                    </Grid>
                </Expander>

                <!-- Known issues -->
                <Expander x:Name="expander3"
                          HorizontalAlignment="Center"
                          Header="Known issues"
                          Width="480" FontSize="16"
                          FontFamily="Segoe UI Semibold">
                    <Grid>
                        <TextBlock x:Name="bodyBlock3"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   FontFamily="Segoe UI"
                                   FontWeight="Normal"
                                   FontSize="14"
                                   Opacity="0.8"
                                   LineHeight="23">
                            • Windows autohide causes heavy flickering and is not supported.
                            <LineBreak/>
                            • Dynamic mode is temporarily disabled in this version and will be re-enabled in a future update.
                            <LineBreak/>
                            • Taskbar modifications other than TranslucentTB are not officially supported.
                        </TextBlock>
                    </Grid>
                </Expander>

                <!-- Help -->
                <Expander x:Name="expander4"
                          HorizontalAlignment="Center"
                          Header="Help and information"
                          Width="480" FontSize="16"
                          FontFamily="Segoe UI Semibold">
                    <Grid>
                        <TextBlock x:Name="bodyBlock4"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   FontFamily="Segoe UI"
                                   FontWeight="Normal"
                                   FontSize="14"
                                   Opacity="0.8"
                                   LineHeight="21">
                            • FluentTB is based on
                            <Hyperlink NavigateUri="https://github.com/torchgm/RoundedTB"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                RoundedTB by torchgm
                            </Hyperlink>
                            — licensed under the GNU General Public License v3.0.
                            <LineBreak/>
                            • FluentTB adds automatic updates, improved stability, and modern Fluent Design.
                            <LineBreak/>
                            • Updates are checked automatically every 24 hours in the background.
                            <LineBreak/>
                            • When an update is available, you'll receive a Windows notification.
                            <LineBreak/>
                            • Click the notification to start the update installation.
                        </TextBlock>
                    </Grid>
                </Expander>

                <!-- Debug -->
                <Expander x:Name="expander5"
                           HorizontalAlignment="Center"
                           Header="Debug"
                           Width="480" FontSize="16"
                           FontFamily="Segoe UI Semibold">
                    <StackPanel>
                        <Button x:Name="configButton"
                                Content="Open config file"
                                Margin="10,10,10,0"
                                Height="30"
                                Click="configButton_Click"/>
                        <Button x:Name="logButton"
                                Content="Open log file"
                                Margin="10,10,10,0"
                                Height="30"
                                Click="logButton_Click"/>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <Button x:Name="okButton"
                Content="OK"
                Margin="0,0,10,10"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Width="85"
                Click="okButton_Click"/>
    </Grid>
</Window>
