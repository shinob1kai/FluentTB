<Page x:Class="FluentFlyoutWPF.Pages.FluentTaskbarPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="{DynamicResource FtbTaskbarTitle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <Page.Resources>
  <Style TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
 </Page.Resources>
 <StackPanel MaxWidth="1000" Margin="16">
  <TextBlock Text="{DynamicResource FtbTaskbarTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <Grid Margin="0,0,0,24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Image Source="/Resources/FluentTBDemoFloatingTaskbar.png" Width="164" Height="119" Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
   <TextBlock Grid.Column="1" Text="{DynamicResource FtbTaskbarDescription}" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </Grid>
  <ui:CardControl x:Name="TaskbarEnabledCard" Tag="Indexable" Margin="0,0,0,16">
   <ui:CardControl.Header><TextBlock Text="{DynamicResource FtbTaskbarTitle}"/></ui:CardControl.Header>
   <ui:ToggleSwitch IsChecked="{Binding ShapeEnabled, Mode=TwoWay}"/>
  </ui:CardControl>
  <ui:CardControl x:Name="TaskbarMarginCard" Tag="Indexable" Margin="0,0,0,3">
   <ui:CardControl.Header><TextBlock Text="{DynamicResource FtbMargin}"/></ui:CardControl.Header>
   <ui:NumberBox x:Name="MarginBox" Value="{Binding MarginValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-100" Maximum="100" Width="130"/>
  </ui:CardControl>
  <ui:CardControl x:Name="TaskbarRadiusCard" Tag="Indexable" Margin="0,0,0,12">
   <ui:CardControl.Header><TextBlock Text="{DynamicResource FtbRadius}"/></ui:CardControl.Header>
   <ui:NumberBox x:Name="RadiusBox" Value="{Binding Radius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" Width="130"/>
  </ui:CardControl>
  <ui:CardExpander Margin="0,0,0,20">
   <ui:CardExpander.Header><TextBlock Text="{DynamicResource FtbIndividual}"/></ui:CardExpander.Header>
   <StackPanel>
    <ui:ToggleSwitch Content="{DynamicResource FtbSeparate}" IsChecked="{Binding IndependentMargins, Mode=TwoWay}" Margin="0,0,0,16"/>
    <UniformGrid Columns="2">
     <StackPanel Margin="0,0,12,12"><TextBlock Text="{DynamicResource FtbTop}"/><ui:NumberBox Value="{Binding Settings.MarginTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-100" Maximum="100"/></StackPanel>
     <StackPanel Margin="0,0,0,12"><TextBlock Text="{DynamicResource FtbBottom}"/><ui:NumberBox Value="{Binding Settings.MarginBottom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-100" Maximum="100"/></StackPanel>
     <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource FtbLeft}"/><ui:NumberBox Value="{Binding Settings.MarginLeft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-100" Maximum="100"/></StackPanel>
     <StackPanel><TextBlock Text="{DynamicResource FtbRight}"/><ui:NumberBox Value="{Binding Settings.MarginRight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-100" Maximum="100"/></StackPanel>
    </UniformGrid>
   </StackPanel>
  </ui:CardExpander>
  <ui:CardControl x:Name="TaskbarOption0Card" Tag="Indexable" Margin="0,0,0,3"><ui:CardControl.Header><StackPanel><TextBlock Text="{DynamicResource FtbDynamic}"/><TextBlock Text="{DynamicResource FtbDynamicDescription}" Opacity="0.65" FontSize="12" TextWrapping="Wrap"/></StackPanel></ui:CardControl.Header><ui:ToggleSwitch IsChecked="{Binding Settings.IsDynamic, Mode=TwoWay}"/></ui:CardControl>
<ui:CardControl x:Name="TaskbarOption1Card" Tag="Indexable" Margin="0,0,0,3"><ui:CardControl.Header><StackPanel><TextBlock Text="{DynamicResource FtbTray}"/><TextBlock Text="{DynamicResource FtbTrayDescription}" Opacity="0.65" FontSize="12" TextWrapping="Wrap"/></StackPanel></ui:CardControl.Header><ui:ToggleSwitch IsChecked="{Binding Settings.ShowTray, Mode=TwoWay}"/></ui:CardControl>
<ui:CardControl x:Name="TaskbarOption2Card" Tag="Indexable" Margin="0,0,0,3"><ui:CardControl.Header><StackPanel><TextBlock Text="{DynamicResource FtbHover}"/><TextBlock Text="{DynamicResource FtbHoverDescription}" Opacity="0.65" FontSize="12" TextWrapping="Wrap"/></StackPanel></ui:CardControl.Header><ui:ToggleSwitch IsChecked="{Binding Settings.ShowTrayOnHover, Mode=TwoWay}"/></ui:CardControl>
<ui:CardControl x:Name="TaskbarOption3Card" Tag="Indexable" Margin="0,0,0,3"><ui:CardControl.Header><StackPanel><TextBlock Text="{DynamicResource FtbWidgets}"/><TextBlock Text="{DynamicResource FtbWidgetsDescription}" Opacity="0.65" FontSize="12" TextWrapping="Wrap"/></StackPanel></ui:CardControl.Header><ui:ToggleSwitch IsChecked="{Binding Settings.ShowWidgets, Mode=TwoWay}"/></ui:CardControl>
<ui:CardControl x:Name="TaskbarOption4Card" Tag="Indexable" Margin="0,0,0,3"><ui:CardControl.Header><StackPanel><TextBlock Text="{DynamicResource FtbMaximised}"/><TextBlock Text="{DynamicResource FtbMaximisedDescription}" Opacity="0.65" FontSize="12" TextWrapping="Wrap"/></StackPanel></ui:CardControl.Header><ui:ToggleSwitch IsChecked="{Binding Settings.FillOnMaximise, Mode=TwoWay}"/></ui:CardControl>
<ui:CardControl x:Name="TaskbarOption5Card" Tag="Indexable" Margin="0,0,0,3"><ui:CardControl.Header><StackPanel><TextBlock Text="{DynamicResource FtbAltTab}"/><TextBlock Text="{DynamicResource FtbAltTabDescription}" Opacity="0.65" FontSize="12" TextWrapping="Wrap"/></StackPanel></ui:CardControl.Header><ui:ToggleSwitch IsChecked="{Binding Settings.FillOnTaskSwitch, Mode=TwoWay}"/></ui:CardControl>
<ui:CardControl x:Name="TaskbarOption6Card" Tag="Indexable" Margin="0,0,0,3"><ui:CardControl.Header><StackPanel><TextBlock Text="{DynamicResource FtbCompatibility}"/><TextBlock Text="{DynamicResource FtbCompatibilityDescription}" Opacity="0.65" FontSize="12" TextWrapping="Wrap"/></StackPanel></ui:CardControl.Header><ui:ToggleSwitch IsChecked="{Binding Settings.CompositionCompat, Mode=TwoWay}"/></ui:CardControl>
  <WrapPanel Margin="0,22,0,0">
   <ui:Button Appearance="Primary" Content="{DynamicResource FtbApply}" Click="Apply_Click"/>
   <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/>
  </WrapPanel>
  <TextBlock Text="{DynamicResource FtbOtherPages}" Opacity="0.6" TextWrapping="Wrap" Margin="0,16,0,0"/>
 </StackPanel>
</Page>
