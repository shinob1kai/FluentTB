<Window x:Class="RoundedTB.TaskbarEffect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoundedTB"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Name="mwin" Title="TaskbarEffect" 
        Width="1920" Height="48"
        AllowsTransparency="True" WindowStyle="None" 
        ResizeMode="NoResize" ShowInTaskbar="False" Background="#02000000">
    <Grid>
        <Grid Name="eye" Width="38" Height="73" Margin="0,10,0,0">
            <Grid.Effect>
                <BlurEffect KernelType="Box" Radius="10"/>
            </Grid.Effect>
        </Grid>
    </Grid>
</Window>