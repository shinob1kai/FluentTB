<Window x:Class="RoundedTB.Infobox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoundedTB"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Infobox" Width="500" Height="430" 
        Visibility="Visible" ResizeMode="NoResize" Opacity="1.001">
    <Grid>
        <TextBlock Name="titleBlock" HorizontalAlignment="Left" VerticalAlignment="Top" 
                   Margin="10,10,0,0" TextWrapping="Wrap" Text="InformationTitle" 
                   FontWeight="Normal" FontFamily="Segoe UI Semibold" FontSize="14"/>
                   
        <TextBlock Name="bodyBlock" Margin="10,34,10,47" TextWrapping="Wrap" 
                   Text="Body of information that's quite interesting. Honestly I'm not sure how you found this as it should never appear in normal use. Are you peeking through the source? I really wouldn't recommend that tbh" 
                   FontWeight="Normal" FontFamily="Segoe UI" FontSize="14"/>
                   
        <Button Name="okButton" Content="OK" Margin="0,0,10,10" 
                VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="37"/>
    </Grid>
</Window>